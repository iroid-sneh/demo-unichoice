<%- include('../layouts/header') %>

    <div class="main-panel">
        <div class="content-wrapper">
            <div class="page-header">
                <!-- <nav aria-label="breadcrumb">
                </nav> -->
                <h2 class="mb-4">Study Materials</h2>
                <a href="/admin/study-materials" class="btn btn-danger">Back</a>
            </div>
            <div class="row">
                <div class="col-12">
                   
                    <div class="card shadow-sm p-4">
                        <% if(success !='' ){ %>
                            <div class="alert alert-success" id="success">
                                <%= success %>
                            </div>
                            <% } %>
                                <% if(error !='' ){ %>
                                    <div class="alert alert-danger" id="error">
                                        <%= error %>
                                    </div>
                                    <% } %>
                                        <div
                                            style="display: flex; justify-content: right; margin-right: 20px; margin-bottom: 30px;">
                                            <a href="/admin/study-materials/addMaterials/<%= collegeId %>" type="button"
                                                class="btn btn-custom-green"
                                                style="background-color: #00AC4D; color: white;">Add
                                                Study Materials</a>
                                        </div>
                                        <div class="table-responsive">
                                            <table id="StudyMaterials" class="table table-striped">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Title</th>
                                                        <th>File Links</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>

                                                </tbody>
                                            </table>
                                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>

    <%- include('../layouts/footer') %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <!-- DataTables -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment-timezone/0.5.40/moment-timezone.min.js"></script>

        <script>

            const collegeId = '<%= collegeId %>';
            const baseUrl = '<%= process.env.APP_URL_ADMIN %>'
            $("#success").show().delay(2000).fadeOut();
            $("#error").show().delay(2000).fadeOut();
            $('#pageTitle').text('Study Materials');
            $('#select-Classes').addClass('active', 'true');

            $(document).ready(function() {
                if($.fn.DataTable) {
                    $("#StudyMaterials").DataTable({
                        paging: true,
                        responsive: true,
                        searching: true,
                        processing: true,
                        serverSide: true,
                        ordering: false,
                        ajax: {
                            url: `/admin/study-materials/materials-list/${collegeId}`,
                            type: "GET",
                        },
                        columns: [
                            {   
                                "width": "10%",
                                "data": "id",
                                "render" : function(data, type, row, meta) {
                                    return meta.row + meta.settings._iDisplayStart + 1;
                                }
                            },
                            {
                                "data": "title",
                                "width": "30%",
                            },
                            {
                                "data": "fileLinks",
                                "width": "30%",
                                "render": function (data) {
                                    if(!data || data.length === 0) {
                                        return 'N/A';
                                    }
                                    let linksHtml = '';
                                    data.forEach(file => {
                                        linksHtml += `<a href="${file.fileLink}" class="btn btn-primary btn-md m-1" target="_blank">${file.docTitle}</a><br>`
                                    });
                                    return linksHtml;
                                }
                            },
                            {   
                                "width": "30%",
                                "data": null,
                                "render": function (data, type, row, meta) {
                                    if(!row.isCompleted) {
                                        return `
                                        <a href=""><button class="btn btn-warning btn-md btn-edit">Edit</button></a>
                                        <a href="" class="btn btn-danger btn-md btn-dlt">Delete</a>
                                        `
                                    } else {
                                        return `<a href="" class="btn btn-danger btn-md btn-dlt">Delete</a>`
                                    }
                                }
                            }
                        ],
                        // columnDefs: [{
                        //     "targets": "_all",
                        //     "className": "text-center"
                        // }],
                    });
                } else {
                    console.error("DataTable is not Loaded");
                }
            });


            $(document).ready(function (ev) {
                $("#StudyMaterials").on("click", '.btn-edit', function (ev) {
                    ev.preventDefault();
                    
                    let row = $(this).closest("tr");
                    let  data = $("#StudyMaterials").DataTable().row(row).data();
                    window.location.href = `/admin/study-materials/updateMaterials/${data._id}`
                })


                $("#StudyMaterials").on("click", ".btn-dlt", function (ev) {
                    ev.preventDefault();

                    let row = $(this).closest("tr");
                    let data = $("#StudyMaterials").DataTable().row(row).data();
                    Swal.fire({
                        title: "Are you sure",
                        text: "do you want to delete this Study Materials, this action can not be undone",
                        icon: "Warning",
                        showCancelButton: true,
                        cancelButtonColor: "#6c757d",
                        confirmButtonColor: "#dc3545",
                        confirmButtonText: "<i class='fas fa-trash'></i> Delete",
                        reverseButtons: true,
                        padding: '2em',
                        customClass: {
                            confirmButton: 'btn btn-danger',
                            cancelButton: 'btn btn-secondary me-3',
                            title: 'fw-bold'
                        },
                        buttonsStyling: false
                    }).then((dlt) => {
                        if(dlt.isConfirmed) {
                            window.location.href = `/admin/study-materials/deleteMaterials/${data._id}`
                            $("#StudyMaterials").DataTable().ajax.reload();
                        }
                    })
                })
            })
            
        </script>