<%- include('../layouts/header') %>
<style>
    #addTagBtn {
        background-color: #00ac4d;
        color: white;
        border: none !important;
    }
    #addTagBtn:hover {
        background-color: #009443;
        color: white;
        border: none !important;
    }
</style>
<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <nav aria-label="breadcrumb"></nav>
        </div>
        <div class="row">
            <div class="col-12 mt-4">
                <h2 class="mb-4">Updates</h2>
                <div class="card shadow-sm p-4">
                    <% if(success !='' ){ %>
                    <div class="alert alert-success" id="success"><%= success %></div>
                    <% } %> <% if(error !='' ){ %>
                    <div class="alert alert-danger" id="error"><%= error %></div>
                    <% } %>
                    <div
                        style="
                            display: flex;
                            justify-content: right;
                            margin-right: 20px;
                            margin-bottom: 30px;
                        "
                    >
                        <a
                            href=""
                            type="button"
                            class="btn btn-custom-green btn-primary mt-3"
                            id="addTagBtn"
                            style="background-color: #00ac4d; color: white"
                        >
                            Add Tag
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table id="myClassesTable" class="table table-striped">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Tag Name</th>
                                    <th>Updates</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>

<!-- Dependencies -->
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
/>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<!-- Add SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        // Fade out success/error messages
        $("#success").show().delay(2000).fadeOut();
        $("#error").show().delay(2000).fadeOut();

        // Initialize DataTable
        if ($.fn.DataTable) {
            $("#myClassesTable").DataTable({
                paging: true,
                responsive: true,
                searching: true,
                processing: true,
                serverSide: true,
                ordering: false,
                ajax: {
                    url: "/admin/updates/tagList",
                    type: "GET",
                },
                columns: [
                    {
                        data: "id",
                        width: "10%",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        },
                    },
                    {
                        data: "name",
                        width: "30%",
                        className: "text-center",
                    },
                    {
                        data: "updates",
                        width: "30%",
                        className: "text-center",
                        render: function (data, type, row, meta) {
                            return `<div class="wrapped-content"> <a class="btn btn-info" 
                                         href="/admin/updates/tagUpdates/${row._id}" role="button">Add Updates</a> </div>`;
                        },
                    },
                    {
                        data: null,
                        width: "30%",
                        className: "text-center",
                        render: function (data, row, meta, type) {
                            return `
                                    <button class="btn btn-warning btn-edit btn-sm" onclick="editTag('${data._id}','${data.name}')" style="background-color: #4e73df; border-color: #4e73df; box-shadow: 0 2px 4px rgba(78, 115, 223, 0.3); transition: all 0.3s ease;">Edit</button>
                                    <a href="#" class="btn btn-danger btn-dlt btn-sm" onclick="deleteUpdate('${data._id}')">Delete</a>
                            `;
                        },
                    },
                ],
            });
        } else {
            console.error("DataTables is not loaded");
        }

        $(".btn-primary").click(function (e) {
            e.preventDefault();

            Swal.fire({
                title: "Add New Tag",
                input: "text",
                inputPlaceholder: "Enter tag name",
                showCancelButton: true,
                confirmButtonText: "Add Tag",
                cancelButtonText: "Cancel",
                showLoaderOnConfirm: true,
                preConfirm: (tagName) => {
                    if (!tagName) {
                        Swal.showValidationMessage("Tag name is required!");
                        return false;
                    }

                    return fetch("/admin/updates/addTag", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({ tagName }),
                    })
                        .then((response) => response.json())
                        .then((data) => {
                            if (!data.success) {
                                throw new Error(data.message || "Failed to add tag");
                            }
                            return data;
                        })
                        .catch((error) => {
                            Swal.showValidationMessage(error.message);
                        });
                },
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Success!",
                        text: "Tag added successfully.",
                        icon: "success",
                        timer: 2000,
                        showConfirmButton: false,
                    });

                    // Reload DataTable after adding a tag
                    $("#myClassesTable").DataTable().ajax.reload();
                }
            });
        });
    });

    // Add this function outside document.ready
    function editTag(tagId, tagName) {
        // console.log("ID", tagId);
        // console.log("name", tagName);
        Swal.fire({
            title: "Edit Tag",
            input: "text",
            inputValue: tagName,
            inputPlaceholder: "Enter new tag name",
            showCancelButton: true,
            confirmButtonText: "Update",
            cancelButtonText: "Cancel",
            showLoaderOnConfirm: true,
            preConfirm: (newTagName) => {
                if (!newTagName) {
                    Swal.showValidationMessage("Tag name is required!");
                    return false;
                }

                return fetch(`/admin/updates/updateTag/${tagId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ tagName: newTagName }),
                })
                    .then((response) => response.json())
                    .then((data) => {
                        if (!data.success) {
                            throw new Error(data.message || "Failed to update tag");
                        }
                        return data;
                    })
                    .catch((error) => {
                        Swal.showValidationMessage(error.message);
                    });
            },
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Success!",
                    text: "Tag updated successfully.",
                    icon: "success",
                    timer: 2000,
                    showConfirmButton: false,
                });

                // Reload DataTable after updating the tag
                $("#myClassesTable").DataTable().ajax.reload();
            }
        });
    }

    // Add delete confirmation
    function deleteUpdate(tagId) {
        Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#3085d6",
            confirmButtonText: "Yes, delete it!",
            showLoaderOnConfirm: true,
            preConfirm: () => {
                return fetch(`/admin/updates/deleteTag/${tagId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                })
                    .then((response) => response.json())
                    .then((data) => {
                        if (!data.success) {
                            throw new Error(data.message || "Failed to delete tag");
                        }
                        return data;
                    })
                    .catch((error) => {
                        Swal.showValidationMessage(error.message);
                    });
            },
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Deleted!",
                    text: "Tag has been deleted successfully.",
                    icon: "success",
                    timer: 2000,
                    showConfirmButton: false,
                });

                // Reload DataTable after deleting the tag
                $("#myClassesTable").DataTable().ajax.reload();
            }
        });
    }
</script>
