<%- include('../layouts/header') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header">
            <h2 class="mb-4">Colleges</h2>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm p-4">
                    <% if(success !='' ){ %>
                    <div class="alert alert-success" id="success"><%= success %></div>
                    <% } %> <% if(error !='' ){ %>
                    <div class="alert alert-danger" id="error"><%= error %></div>
                    <% } %>

                    <div class="text-end mb-3">
                        <a
                            href="/admin/colleges/addColleges"
                            class="btn btn-custom-green btn-primary mt-3"
                            style="background-color: #00ac4d; color: white"
                        >
                            Add College
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table id="collegesTable" class="table table-striped">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">Index</th>
                                    <th class="text-center">Name</th>
                                    <th class="text-center">State</th>
                                    <th class="text-center">City</th>
                                    <th class="text-center">College Logo</th>
                                    <th class="text-center">NIRF ranking</th>
                                    <th class="text-center">Stream</th>
                                    <th class="text-center">Average Tuition Fee's</th>
                                    <th class="text-center">Top 200</th>
                                    <th class="text-center">Free Application</th>
                                    <th class="text-center">Updates</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../layouts/footer') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {
        $("#success").show().delay(2000).fadeOut();
        $("#error").show().delay(2000).fadeOut();
        $("#pageTitle").text("Colleges");
        $("#select-collegesTable").addClass("active", "true");

        if ($.fn.DataTable) {
            $("#collegesTable").DataTable({
                paging: true,
                responsive: true,
                searching: true,
                processing: true,
                serverSide: true,
                ordering: false,
                ajax: {
                    url: "/admin/colleges/list",
                    type: "GET",
                },
                columns: [
                    {
                        data: "index",
                        render: function (data, type, row, meta) {
                            return row.index ? row.index : "N/A";
                        },
                    },
                    { data: "name" },
                    {
                        data: "state",
                        render: function (data, type, row, meta) {
                            return row.state ? row.state.name : "N/A";
                        },
                    },
                    { data: "city" },
                    {
                        data: "image",
                        render: function (data) {
                            return data == null
                                ? `<img src="${"<%= process.env.APP_URL_ADMIN %>"}/myClasses/background.jpg" height="70" style="border-radius: 0; width: 100px; height: 100px;" />`
                                : `<img src="${"<%= process.env.APP_URL_ADMIN %>"}/${data}" style="border-radius: 0; width: 100px; height: 100px;"/>`;
                        },
                    },
                    {
                        data: "nirfRank",
                        render: function (data, type, row, meta) {
                            return row.nirfRank ? row.nirfRank : "N/A";
                        },
                    },
                    {
                        data: "stream",
                        render: function (data, type, row, meta) {
                            return row.stream
                                .map((type) => {
                                    let badgeClass = "";
                                    switch (type.name) {
                                        case "Management":
                                            badgeClass = "badge-info";
                                            break;
                                        case "Medical":
                                            badgeClass = "badge-danger";
                                            break;
                                        case "Engineering":
                                            badgeClass = "badge-warning text-dark";
                                            break;
                                        case "Law":
                                            badgeClass = "badge-success text-dark";
                                            break;
                                        case "Arts & Science":
                                            badgeClass = "badge-secondary text-dark";
                                            break;
                                        default:
                                            badgeClass = "badge-secondary text-dark";
                                    }
                                    return `<span class="badge ${badgeClass}">${type.name}</span>`;
                                })
                                .join(" ");
                        },
                    },
                    {
                        data: "averageTutionFee",
                        render: function (data, type, row, meta) {
                            return row.averageTutionFee ? row.averageTutionFee : "N/A";
                        },
                    },
                    {
                        data: "top200",
                        render: function (data, type, row, meta) {
                            return row.top200
                                ? '<span class="badge bg-success">Yes</span>'
                                : '<span class="badge bg-danger">No</span>';
                        },
                    },
                    {
                        data: "freeApplication",
                        render: function (data, type, row, meta) {
                            return row.freeApplication
                                ? '<span class="badge bg-success">Yes</span>'
                                : '<span class="badge bg-danger">No</span>';
                        },
                    },
                    {
                        data: "updates",
                        render: function (data, type, row, meta) {
                            const statusBadge = row.updates;
                            return `<div class="wrapped-content"> <a class="btn btn-info" 
                                         href="/admin/colleges/updates/${row._id}" role="button">College Updates</a> </div>`;
                        },
                    },
                    {
                        data: null,
                        render: function (data) {
                            return `
                                <a href="#" class="btn btn-warning btn-edit btn-sm" style="background-color: #4e73df; border-color: #4e73df; box-shadow: 0 2px 4px rgba(78, 115, 223, 0.3); transition: all 0.3s ease;">Edit</a>
                                <a href="#" class="btn btn-danger btn-dlt btn-sm">Delete</a>
                            `;
                        },
                    },
                ],
                columnDefs: [
                    {
                        targets: "_all",
                        className: "text-center",
                    },
                ],
            });
        } else {
            console.error("DataTables is not loaded");
        }
    });

    $(document).ready(function () {
        $("#collegesTable").on("click", ".btn-edit", function (ev) {
            ev.preventDefault();

            let row = $(this).closest("tr");
            let data = $("#collegesTable").DataTable().row(row).data();

            window.location.href = `/admin/colleges/updateColleges/${data._id}`;
        });

        $("#collegesTable").on("click", ".btn-dlt", function (ev) {
            ev.preventDefault();
            let row = $(this).closest("tr");
            let data = $("#collegesTable").DataTable().row(row).data();
            Swal.fire({
                title: "Are you Sure",
                text: "do you want to delete this?",
                icon: "Warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Yes, delete",
            }).then((dlt) => {
                if (dlt.isConfirmed) {
                    window.location.href = `/admin/colleges/deleteColleges/${data._id}`;
                }
            });
        });

        $("#collegesTable").on("click", ".btn-set-update", function (ev) {
            ev.preventDefault();
            let row = $(this).closest("tr");
            let data = $("#collegesTable").DataTable().row(row).data();

            Swal.fire({
                title: "Update Status",
                text: "Do you want to toggle the update status?",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, toggle it",
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/admin/colleges/toggleUpdate/${data._id}`;
                }
            });
        });
    });
</script>
