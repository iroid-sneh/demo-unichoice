<%- include('../layouts/header') %>

<style>
    /* Ensure all table cells have centered text */
table.dataTable td, table.dataTable th {
    text-align: center !important;
    vertical-align: middle !important;
}

/* Ensure images are properly centered */
table.dataTable img {
    display: block;
    margin: 0 auto;
}

/* Ensure wrapped text remains centered */
.wrapped-content {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}
</style>
    <div class="main-panel">
        <div class="content-wrapper">
            <div class="page-header">
                <nav aria-label="breadcrumb">
                </nav>
            </div>
            <div class="row">
                <div class="col-12">
                    <h2 class="mb-4">My Classes</h2>
                    <div class="card shadow-sm p-4">
                        <% if(success !='' ){ %>
                            <div class="alert alert-success" id="success">
                                <%= success %>
                            </div>
                            <% } %>
                                <% if(error !='' ){ %>
                                    <div class="alert alert-danger" id="error">
                                        <%= error %>
                                    </div>
                                    <% } %>
                                        <div
                                            style="display: flex; justify-content: right; margin-right: 20px; margin-bottom: 30px;">
                                            <a href="/admin/myClasses/addClasses" type="button"
                                                class="btn btn-custom-green"
                                                style="background-color: #00AC4D; color: white;">Add
                                                Classes</a>
                                        </div>
                                        <div class="table-responsive">
                                            <table id="myClassesTable" class="table table-striped">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>ID</th>
                                                        <th>Image</th>
                                                        <th>Class Name</th>
                                                        <th>Description</th>
                                                        <th>Join Link</th>
                                                        <th>Type</th>
                                                        <th>Start Time</th>
                                                        <th>End Time</th>
                                                        <th>Actions</th>

                                                    </tr>
                                                </thead>
                                                <tbody>

                                                </tbody>
                                            </table>
                                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>

    <%- include('../layouts/footer') %>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <!-- DataTables -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/moment-timezone/0.5.40/moment-timezone.min.js"></script>

        <script>
            $("#success").show().delay(2000).fadeOut();
            $("#error").show().delay(2000).fadeOut();
            $('#pageTitle').text('My Classes');
            $('#select-Classes').addClass('active', 'true');

            $(document).ready(function () {

                if ($.fn.DataTable) {
                    $('#myClassesTable').DataTable({
                        paging: true,
                        responsive: true,
                        searching: true,
                        processing: true,
                        serverSide: true,
                        ordering: false,
                        ajax: {
                            url: "/admin/myClasses/list",
                            type: "GET",
                        },
                        columns: [
                            {
                                "data": "id",
                                "render": function (data, type, row, meta) {
                                    return meta.row + meta.settings._iDisplayStart + 1;
                                }
                            },
                            {
                                "data": "thumbnail",
                                "render": function (data) {
                                    return data == null ? `<img src="${'<%= process.env.APP_URL_ADMIN %>'}/myClasses/background.jpg" height="70" style="border-radius: 0; width: 100px; height: 100px;" />` : `<img src="${'<%= process.env.APP_URL_ADMIN %>'}/${data}" style="border-radius: 0; width: 100px; height: 100px;"/>`;
                                }
                            },
                            {
                                "data": "className",
                            },
                            {
                                "data": "description",
                                "render": function (data, type, row, meta) {
                                    return (!row.description || row.description.trim() === '') ? `<div style="text-align: center; font-weight: 700;">-</div>` : `<div class="wrapped-content" style="width: 400px; word-wrap: break-word; text-wrap: initial;">${row.description}</div>`;
                                }
                            },
                            {
                                "data": "embadedLink",
                                "render": function (data) {
                                    return data ? `<a href="${data}" target="_blank" class="btn btn-primary btn-md">Join Live</a>` : 'N/A';
                                }
                            },
                            {
                                "data": "type",
                                "render": function (data, type, row) {
                                    const currentTime = new Date();
                                    const isLive = new Date(row.startTime) <= currentTime && new Date(row.endTime) >= currentTime;

                                    if (isLive) {
                                        return '<span class="badge badge-danger">Live</span>';
                                    }

                                    return data.map(type => {
                                        let badgeClass = '';
                                        switch (type) {
                                            case 'Exclusive':
                                                badgeClass = 'badge-info';
                                                break;
                                            case 'Important':
                                                badgeClass = 'badge-danger';
                                                break;
                                            case 'Popular':
                                                badgeClass = 'badge-warning text-dark';
                                                break;
                                            case 'Must Attend':
                                                badgeClass = 'badge-success text-dark';
                                                break;
                                            default:
                                                badgeClass = 'badge-secondary';
                                        }
                                        return `<span class="badge ${badgeClass}">${type}</span>`;
                                    }).join(' ');
                                }
                            },
                            {
                                "data": "startTime",
                                "render": function (data, type, row, meta) {
                                    return moment(row.startTime).tz("Asia/Kolkata").format("DD-MM-YYYY h:mm A");
                                }
                            },
                            {
                                "data": "endTime",
                                "render": function (data, type, row, meta) {
                                    return moment(row.endTime).tz("Asia/Kolkata").format("DD-MM-YYYY h:mm A");
                                }
                            },
                            {
                                "data": null,
                                "render": function (data, type, row, meta) {
                                    if (!row.isCompleted) {
                                        return `
                                        <a href=""><button class="btn btn-warning btn-edit btn-md">Edit</button></a>
                                        <a href="" class="btn btn-danger btn-dlt btn-md">Delete</a>`;
                                    } else {
                                        return `
                                        <a href="" class="btn btn-danger btn-dlt btn-md">Delete</a>`;
                                    }
                                }
                            }
                        ],
                        // columnDefs: [{
                        //     "targets": "_all",
                        //     "className": "text-center"
                        // }],
                    });
                } else {
                    console.error("DataTables is not loaded");
                }
            });

            $(document).ready(function () {
                $("#myClassesTable").on("click", '.btn-edit', function (ev) {
                    ev.preventDefault();

                    let row = $(this).closest("tr");
                    let data = $("#myClassesTable").DataTable().row(row).data();
                    window.location.href = `/admin/myClasses/updateClasses/${data._id}`
                })

                $("#myClassesTable").on("click", '.btn-dlt', function (ev) {
                    ev.preventDefault();
                    let row = $(this).closest("tr");
                    let data = $("#myClassesTable").DataTable().row(row).data();
                    Swal.fire({
                        title: "Are you Sure",
                        text: "do you want to delete this?",
                        icon: "Warning",
                        showCancelButton: true,
                        confirmButtonColor: "#d33",
                        cancelButtonColor: "#3085d6",
                        confirmButtonText: "Yes, delete",
                    }).then((dlt) => {
                        if (dlt.isConfirmed) {
                            window.location.href = `/admin/myClasses/delete/${data._id}`
                        }
                    });
                })
            });

        </script>