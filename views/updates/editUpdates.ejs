<%- include('../layouts/header') %> <%= update.type %>
<style>
    .error {
        color: red;
    }

    .form-control {
        padding: 10px;
    }

    select.form-control {
        padding: 10px;
    }

    .cke_notifications_area {
        display: none;
    }
</style>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="col-lg-6 mx-auto">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold" style="font-size: 20px">Edit Update</h6>
                    <a href="/admin/updates/tagUpdates/<%= tag %>" class="btn btn-danger">Back</a>
                </div>
                <div class="card-body">
                    <form id="collegeForm" method="post" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>
                                Title
                                <span class="text-danger">*</span>
                            </label>
                            <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                placeholder="Enter Title"
                                required
                                value="<%= update.title %>"
                            />
                        </div>

                        <div class="form-group" id="descGroup">
                            <label>
                                Description
                                <span class="text-danger">*</span>
                            </label>
                            <textarea name="description" id="editor" required>
<%= update.description %></textarea
                            >
                        </div>

                        <div class="form-group" id="mediaGroup">
                            <label>
                                <%=update.type=== '3' ? 'Image' : 'Video' %>
                                <span class="text-danger">*</span>
                            </label>
                            <input type="file" class="form-control" id="mediaFiles"
                            name="mediaFiles" <%=update.type==='3' ? '' : 'multiple' %>>
                            <div id="mediaPreviewContainer" class="mt-3 d-flex flex-wrap gap-3">
                                <!-- Previews will be loaded dynamically -->
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <input type="checkbox" style="width: 20px; height: 20px;" id="isPinned"
                            name="isPinned" value="true" <%=update.isPinned ? 'checked' : '' %>>
                            <label style="margin-left: 10px; margin-top: 3px">Pin</label>
                        </div>
                        <label class="pin-error text-danger mt-2" id="pin-error"></label>
                        <br />

                        <button
                            type="submit"
                            class="btn btn-custom-green btn-primary mt-3"
                            style="background-color: #00ac4d; color: white"
                        >
                            Submit
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

<script>
    CKEDITOR.replace("editor", {
        toolbar: [
            {
                name: "basicstyles",
                items: ["Bold", "Italic", "Underline", "Strike", "Subscript", "Superscript"],
            },
            { name: "paragraph", items: ["NumberedList", "BulletedList"] },
            { name: "insert", items: ["SpecialChar"] },
            { name: "tools", items: ["Maximize", "ShowBlocks"] },
        ],
    });

    $(document).ready(function () {
        const selectedType = "<%= update.type %>"; // Get the selected type from update

        const tag = "<%= tag._id %>";
        const update = "<%= update._id %>";
        $.ajax({
            url: `/admin/updates/checkIspinned/${tag}/${update}`,
            type: "GET",
            success: function (response) {
                if (!response.success && !response.isCurrentPinned) {
                    $(".pin-error").text(
                        "If you want to pin this update please unpin the previous update first."
                    );
                    $("#isPinned").prop("checked", false);
                    $("#isPinned").prop("disabled", true);
                } else if (response.success && !response.isCurrentPinned) {
                    $("#isPinned").prop("disabled", false);
                } else {
                    $("#isPinned").prop("disabled", false);
                }
            },
        });

        // Add this new function to load media previews
        async function loadMediaPreviews() {
            try {
                const response = await fetch(
                    `/admin/colleges/updates/view-images-videos/<%= update._id %>`
                );
                const mediaFiles = await response.json();
                const previewContainer = $("#mediaPreviewContainer");
                previewContainer.empty();

                mediaFiles.data.forEach((file) => {
                    const isVideo = file.url.endsWith(".mp4");

                    if (isVideo) {
                        previewContainer.append(`
                            <div class="position-relative" id="videoPreview">
                                <video width="150" height="150" controls>
                                    <source src="${file.url}" type="video/mp4">
                                </video>
                                <button type="button" class="btn btn-danger btn-sm position-absolute" 
                                    style="top: 5px; right: 5px;"
                                    onclick="deleteMedia('${file._id}')">×</button>
                            </div>
                        `);
                    } else {
                        previewContainer.append(`
                            <div class="position-relative">
                                <img src="${file.url}" width="150" height="150" style="object-fit: cover;">
                                <button type="button" class="btn btn-danger btn-sm position-absolute" 
                                    style="top: 5px; right: 5px;"
                                    onclick="deleteMedia('${file._id}')">×</button>
                            </div>
                        `);
                    }
                });

                // Add event listener for video file input if type is 3
                if (selectedType === "3") {
                    $("#mediaFiles").on("change", function (e) {
                        const file = this.files[0];
                        if (file) {
                            // Remove existing video preview
                            $("#videoPreview").remove();

                            // Create new video preview without delete button
                            const reader = new FileReader();
                            reader.onload = function (e) {
                                previewContainer.html(`
                                                <div class="position-relative" id="videoPreview">
                                                    <video width="150" height="150" controls>
                                                        <source src="${e.target.result}" type="video/mp4">
                                                    </video>
                                                    <button type="button" class="btn btn-danger btn-sm position-absolute" 
                                                        style="top: 5px; right: 5px;"
                                                        onclick="removeVideoPreview()">×</button>
                                                </div>
                                            `);
                            };
                            reader.readAsDataURL(file);
                        }
                    });
                }
                window.removeVideoPreview = function () {
                    $("#videoPreview").remove();
                    $("#mediaFiles").val("").prop("disabled", false); // Clear input and allow new upload
                };
            } catch (error) {
                console.error("Error loading media previews:", error);
            }
        }

        // Add delete media function
        window.deleteMedia = async function (filePath) {
            try {
                const response = await fetch(`/admin/colleges/deleteImage/${filePath}`, {
                    method: "DELETE",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({ filePath }),
                });

                if (response.ok) {
                    loadMediaPreviews(); // Reload the previews
                } else {
                    alert("Failed to delete media");
                }
            } catch (error) {
                console.error("Error deleting media:", error);
                alert("Error deleting media");
            }
        };

        // Modify handleNewImagePreviews function to prevent duplicate files
        function handleNewImagePreviews(inputFiles) {
            const previewContainer = $("#mediaPreviewContainer");
            const dataTransfer = new DataTransfer();

            // Only add the new files, don't include existing ones
            Array.from(inputFiles).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewContainer.append(`
                                    <div class="position-relative new-preview" data-file-index="${index}">
                                        <img src="${e.target.result}" width="150" height="150" style="object-fit: cover;">
                                        <button type="button" class="btn btn-danger btn-sm position-absolute" 
                                            style="top: 5px; right: 5px;"
                                            onclick="removeNewPreview(this)">×</button>
                                    </div>
                                `);
                };
                reader.readAsDataURL(file);
                dataTransfer.items.add(file);
            });

            // Update the input files with only the new files
            $("#mediaFiles")[0].files = dataTransfer.files;
        }

        // Modify removeNewPreview to update the file input
        window.removeNewPreview = function (button) {
            const preview = $(button).closest(".new-preview");
            const fileIndex = preview.data("file-index");

            // Create new DataTransfer
            const dataTransfer = new DataTransfer();
            const currentFiles = $("#mediaFiles")[0].files;

            // Add all files except the removed one
            Array.from(currentFiles).forEach((file, index) => {
                if (index !== fileIndex) {
                    dataTransfer.items.add(file);
                }
            });

            // Update the input files
            $("#mediaFiles")[0].files = dataTransfer.files;
            preview.remove();
        };

        // Modify the mediaFiles change event handler
        $("#mediaFiles").on("change", function (e) {
            if (selectedType === "2") {
                // For images
                handleNewImagePreviews(this.files);
            } else if (selectedType === "3") {
                // Existing video preview code
                const file = this.files[0];
                if (file) {
                    $("#videoPreview").remove();
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $("#mediaPreviewContainer").html(`
                                        <div class="position-relative" id="videoPreview">
                                            <video width="150" height="150" controls>
                                                <source src="${e.target.result}" type="video/mp4">
                                            </video>
                                            <button type="button" class="btn btn-danger btn-sm position-absolute" 
                                                style="top: 5px; right: 5px;"
                                                onclick="removeVideoPreview()">×</button>
                                        </div>
                                    `);
                    };
                    reader.readAsDataURL(file);
                }
            }
        });

        function manageFields() {
            $("#descGroup, #mediaGroup").hide(); // Hide all optional inputs
            $("#isPinned").closest(".form-group").show(); // Always show isPinned

            if (selectedType == "1") {
                $("#descGroup").show();
            } else if (selectedType == "2") {
                $("#mediaGroup").show();
                $("#description").val(null);
                $("#mediaFiles")
                    .attr("accept", "image/jpg, image/jpeg, image/png")
                    .prop("multiple", true);
            } else if (selectedType == "3") {
                $("#mediaGroup").show();
                $("#description").val(null);
                $("#mediaFiles").attr("accept", "video/mp4").prop("multiple", false);
                // Add validation for single video
                $("#mediaFiles").on("change", function () {
                    if (this.files.length > 1) {
                        alert("Only one video file can be uploaded");
                        this.value = "";
                    }
                });
            }

            $("#collegeForm").validate({
                rules: {
                    title: {
                        required: true,
                    },
                    description: {
                        required: selectedType == "1",
                    },
                    mediaFiles: {
                        required: function () {
                            // Require media files if type is 2 or 3 AND preview container is empty
                            return (
                                (selectedType === "2" || selectedType === "3") &&
                                $("#mediaPreviewContainer").children().length === 0
                            );
                        },
                    },
                },
                messages: {
                    title: {
                        required: "Please enter a title",
                    },
                    description: {
                        required: "Please enter a description",
                    },
                    mediaFiles: {
                        required: "Please upload at least one media file",
                    },
                },
            });
        }

        $("#collegeForm").on("submit", function (e) {
            e.preventDefault();
            if ($(this).valid()) {
                if (CKEDITOR.instances.editor) {
                    CKEDITOR.instances.editor.updateElement();
                }
                let editorData = CKEDITOR.instances.editor.getData();
                const formData = new FormData(this);
                $("#editor").val(editorData);

                fetch(window.location.href, {
                    method: "POST",
                    body: formData,
                })
                    .then((response) => {
                        window.location.href = `/admin/updates/tagUpdates/<%= tag %>`;
                    })
                    .catch((error) => {
                        console.error("Error:", error);
                        alert("Error updating the college");
                    });
            }
        });

        manageFields(); // Call function to set fields based on the selected type
        loadMediaPreviews(); // Load existing media previews

        // Update back button prevention with validation
        window.onload = function () {
            window.history.pushState(null, "", window.location.href);
            window.addEventListener("popstate", function () {
                window.history.pushState(null, "", window.location.href);

                // Check if media is required and missing
                const isMediaRequired = selectedType === "2" || selectedType === "3";
                const hasMediaFiles = $("#mediaPreviewContainer").children().length > 0;

                if (isMediaRequired && !hasMediaFiles) {
                    Swal.fire({
                        title: "Required Media Missing",
                        text: "Please upload at least one media file before leaving",
                        icon: "error",
                        confirmButtonColor: "#3085d6",
                        confirmButtonText: "OK",
                    });
                    return;
                }

                // If media requirements are met, show leave confirmation
                Swal.fire({
                    title: "Are you sure?",
                    text: "You will lose any unsaved changes!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, leave page",
                    cancelButtonText: "Stay",
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = `/admin/updates/tagUpdates/<%= tag %>`;
                    }
                });
            });
        };
    });
</script>
